{
  "name": "tigacode-cli",
  "version": "0.1.2",
  "description": "基于终端的 AI 编程助手 CLI 工具",
  "type": "module",
  "main": "./dist/cli.js",
  "bin": {
    "tigacode": "bin/check-node-version.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/cli.tsx",
    "dev:tsx": "tsx src/cli.tsx",
    "dev:babel": "npm run build:babel && concurrently --kill-others --names \"babel,node\" \"babel src --out-dir .babel-out --extensions .ts,.tsx --watch\" \"node --watch .babel-out/cli.js\"",
    "devrecord": "tsx src/devmock/cli.tsx --record default.json",
    "devmock": "tsx src/devmock/cli.tsx --mock default.json",
    "typecheck": "tsc -p ./ --noEmit",
    "typecheck:test": "tsc -p ./tsconfig.test.json --noEmit",
    "test:inputbox": "node --import tsx --test tests/inputBoxModel.test.ts",
    "test:shell": "node --import tsx --test tests/shellTool.test.ts",
    "test:style": "node --import tsx --test tests/codeStyle.test.ts",
    "test:tools": "node --import tsx --test tests/toolsEdit.test.ts tests/toolsSearch.test.ts tests/toolsWorkspacePath.test.ts tests/shellTool.test.ts tests/gitTool.test.ts",
    "test:all": "npm run typecheck:test && node --import tsx --test tests/*.test.ts",
    "build:babel": "node -e \"require('node:fs').rmSync('.babel-out',{recursive:true,force:true})\" && babel src --out-dir .babel-out --extensions .ts,.tsx --ignore \"src/devmock/**\",\"src/test/**\"",
    "build:bundle": "esbuild .babel-out/cli.js --bundle --platform=node --format=esm --outfile=dist/cli.js --banner:js=\"#!/usr/bin/env node\" --packages=external",
    "build": "npm run typecheck && npm run test:style && npm run build:babel && npm run build:bundle",
    "prepare:package": "node scripts/prepare-package.js",
    "prepublishOnly": "node scripts/prepare-package.js"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "gray-matter": "^4.0.3",
    "ink": "^7.1.0",
    "openai": "^6.44.0",
    "react": "^19.2.7",
    "string-width": "^8.2.2",
    "yargs": "^18.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.4",
    "@babel/core": "^8.0.1",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/yargs": "^17.0.35",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.4",
    "esbuild": "^0.28.1",
    "react-devtools-core": "^7.0.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
