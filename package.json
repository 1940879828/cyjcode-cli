{
  "name": "cyjcode-cli",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "cyjcode": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build:babel && concurrently --kill-others --raw --names \"babel,node\" \"babel src --out-dir .babel-out --extensions .ts,.tsx --watch\" \"node --watch .babel-out/cli.js\"",
    "dev:tsx": "tsx src/cli.tsx",
    "devrecord": "npm run build:babel && node .babel-out/cli.js --record default",
    "devmock": "npm run build:babel && node .babel-out/cli.js --mock default",
    "typecheck": "tsc -p ./ --noEmit",
    "build:babel": "babel src --out-dir .babel-out --extensions .ts,.tsx",
    "build:bundle": "esbuild .babel-out/cli.js --bundle --platform=node --format=esm --outfile=dist/cli.js --banner:js=\"#!/usr/bin/env node\" --packages=external",
    "build": "npm run typecheck && npm run build:babel && npm run build:bundle"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "ink": "^7.1.0",
    "openai": "^6.44.0",
    "react": "^19.2.7",
    "string-width": "^8.2.2",
    "yargs": "^18.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.4",
    "@babel/core": "^8.0.1",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/yargs": "^17.0.35",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.4",
    "esbuild": "^0.28.1",
    "react-devtools-core": "^7.0.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
