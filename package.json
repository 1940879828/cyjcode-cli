{
  "name": "cyjcode-cli",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "cyjcode": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/cli.tsx",
    "typecheck": "tsc -p ./ --noEmit",
    "build": "npm run typecheck && esbuild src/cli.tsx --bundle --platform=node --format=esm --outfile=dist/cli.js --banner:js=\"#!/usr/bin/env node\" --packages=external"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "ink": "^7.1.0",
    "openai": "^6.44.0",
    "react": "^19.2.7",
    "yargs": "^18.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/yargs": "^17.0.35",
    "esbuild": "^0.28.1",
    "react-devtools-core": "^7.0.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
