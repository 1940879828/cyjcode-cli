{
  "presets": [
    "@babel/preset-typescript",
    [
      "@babel/preset-react",
      {
        "runtime": "automatic",
        "development": false
      }
    ]
  ],
  "plugins": [
    [
      "babel-plugin-react-compiler",
      {
        "target": "19"
      }
    ]
  ],
  "ignore": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "devmock/**",
    "test/**"
  ]
}
